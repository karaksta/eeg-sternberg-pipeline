# Используем официальный образ Python (версия 3.9, как в вашем venv)
FROM python:3.9-slim

# Устанавливаем рабочую директорию внутри контейнера
WORKDIR /app

# Копируем файл зависимостей
COPY requirements.txt .

# Устанавливаем все библиотеки
RUN pip install --no-cache-dir -r requirements.txt

# Копируем весь проект в контейнер
COPY . .

# Команда, которая выполняется при запуске контейнера
# (по умолчанию запускаем главный скрипт пайплайна)
CMD ["python", "scripts/run_all.py"]
